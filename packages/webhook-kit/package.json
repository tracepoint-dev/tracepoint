{
  "name": "@tracepoint-dev/webhook-kit",
  "version": "0.2.0",
  "description": "Mountable receiver for Tracepoint reports — store, dashboard, and outbound chain.",
  "license": "MIT",
  "author": "Amit Mishra",
  "homepage": "https://github.com/tracepoint-dev/tracepoint/tree/main/packages/webhook-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracepoint-dev/tracepoint.git",
    "directory": "packages/webhook-kit"
  },
  "bugs": "https://github.com/tracepoint-dev/tracepoint/issues",
  "keywords": ["feedback", "bug-report", "webhook", "receiver", "dashboard", "self-hosted"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js",
      "require": "./dist/stores/index.cjs"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "import": "./dist/connectors/index.js",
      "require": "./dist/connectors/index.cjs"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js",
      "require": "./dist/dashboard/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./node": {
      "types": "./dist/node-http.d.ts",
      "import": "./dist/node-http.js",
      "require": "./dist/node-http.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.10",
    "better-sqlite3": ">=11",
    "zod": ">=3.25"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "better-sqlite3": "^11.5.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "zod": "^3.25.0"
  }
}
