{
  "name": "@tracepoint-dev/core",
  "version": "0.0.0",
  "description": "Framework-agnostic core of the Tracepoint feedback & diagnostics SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/tracepoint.global.js"
  },
  "unpkg": "./dist/tracepoint.global.js",
  "jsdelivr": "./dist/tracepoint.global.js",
  "files": ["dist"],
  "sideEffects": ["./dist/tracepoint.global.js"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "modern-screenshot": "^4.6.0"
  }
}
