{
  "name": "@tracepoint-dev/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core of the Tracepoint feedback & diagnostics SDK.",
  "license": "MIT",
  "author": "Amit Mishra",
  "homepage": "https://github.com/tracepoint-dev/tracepoint/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracepoint-dev/tracepoint.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/tracepoint-dev/tracepoint/issues",
  "keywords": ["feedback", "bug-report", "diagnostics", "screenshot", "annotation", "dom", "sdk"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/tracepoint.global.js",
    "./schema": "./schema/tracepoint.schema.json"
  },
  "unpkg": "./dist/tracepoint.global.js",
  "jsdelivr": "./dist/tracepoint.global.js",
  "files": ["dist", "schema"],
  "sideEffects": ["./dist/tracepoint.global.js"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "modern-screenshot": "^4.6.0"
  }
}
