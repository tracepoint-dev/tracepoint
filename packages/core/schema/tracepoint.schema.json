{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracepoint.dev/schema/2.0/report.json",
  "title": "Tracepoint report envelope",
  "description": "The JSON a Tracepoint SDK POSTs to a webhook. schemaVersion 2.0 — additive over 1.0: console / errors / network / capture and target.component.",
  "type": "object",
  "required": [
    "tracepoint",
    "id",
    "createdAt",
    "report",
    "page",
    "client",
    "context",
    "console",
    "errors",
    "network",
    "capture"
  ],
  "additionalProperties": true,
  "properties": {
    "tracepoint": {
      "type": "object",
      "required": ["schemaVersion", "sdkVersion"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "2.0" },
        "sdkVersion": { "type": "string" }
      }
    },
    "id": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "report": {
      "type": "object",
      "required": ["description", "annotations"],
      "properties": {
        "description": { "type": "string" },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["selection-rect"] },
              "rect": { "$ref": "#/$defs/rect" }
            }
          }
        }
      }
    },
    "target": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/descriptor" }]
    },
    "page": {
      "type": "object",
      "required": ["url", "route", "title", "referrer"],
      "properties": {
        "url": { "type": "string" },
        "route": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "referrer": { "type": ["string", "null"] }
      }
    },
    "screenshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["mimeType", "dataUrl", "width", "height"],
          "properties": {
            "mimeType": { "type": "string" },
            "dataUrl": { "type": "string", "description": "data: URL, base64" },
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        }
      ]
    },
    "client": {
      "type": "object",
      "required": ["userAgent", "viewport", "screen", "language", "timezone"],
      "properties": {
        "userAgent": { "type": "string" },
        "viewport": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "dpr": { "type": "number" }
          }
        },
        "screen": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "language": { "type": "string" },
        "timezone": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "description": "App-supplied key/values. Redacted + size-capped. Empty unless the app sets it.",
      "additionalProperties": true
    },
    "console": {
      "type": "array",
      "description": "Console history. Empty unless `console` capture is opted in. Oldest-first.",
      "items": {
        "type": "object",
        "required": ["level", "message", "ts"],
        "properties": {
          "level": { "type": "string", "enum": ["log", "info", "warn", "error", "debug"] },
          "message": { "type": "string", "description": "Redacted, serialized args." },
          "ts": { "type": "number", "description": "ms since performance.timeOrigin." },
          "count": {
            "type": "integer",
            "description": "Present + >1 when consecutive duplicates collapsed."
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Uncaught errors + unhandled rejections. Rides with `console` capture.",
      "items": {
        "type": "object",
        "required": ["name", "message", "stack", "ts", "kind"],
        "properties": {
          "name": { "type": "string" },
          "message": { "type": "string" },
          "stack": { "type": "string", "description": "Query strings scrubbed from frame URLs." },
          "ts": { "type": "number" },
          "kind": { "type": "string", "enum": ["error", "rejection"] }
        }
      }
    },
    "network": {
      "type": "array",
      "description": "Request metadata only — never bodies or headers. Empty unless `network` capture is opted in.",
      "items": {
        "type": "object",
        "required": ["method", "url", "status", "durationMs", "ts"],
        "properties": {
          "method": { "type": "string" },
          "url": { "type": "string", "description": "Sensitive query params scrubbed." },
          "status": { "type": ["integer", "null"], "description": "null on a network failure." },
          "durationMs": { "type": "number" },
          "reqBytes": { "type": "integer" },
          "resBytes": { "type": "integer", "description": "From Content-Length, when present." },
          "ts": { "type": "number" },
          "failed": { "type": "boolean" }
        }
      }
    },
    "capture": {
      "type": "object",
      "description": "What was collected and what was trimmed, so a consumer knows what to trust.",
      "required": ["console", "network", "truncated"],
      "properties": {
        "console": { "type": "boolean" },
        "network": { "type": "boolean" },
        "truncated": {
          "type": "object",
          "properties": {
            "console": { "type": "integer" },
            "network": { "type": "integer" }
          }
        }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "descriptor": {
      "type": "object",
      "description": "Everything captured about the picked element.",
      "properties": {
        "primarySelector": { "type": "string" },
        "generatedSelector": { "type": "string" },
        "selectorConfidence": { "type": "string", "enum": ["semantic", "positional"] },
        "selectorResolves": { "type": "boolean" },
        "selectorMatchCount": { "type": "integer" },
        "xpath": { "type": "string" },
        "testId": { "type": ["string", "null"] },
        "id": { "type": ["string", "null"] },
        "tag": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "value": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "ariaRole": { "type": ["string", "null"] },
        "accessibleName": { "type": ["string", "null"] },
        "interactiveAncestor": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "selector": { "type": "string" },
                "tag": { "type": "string" },
                "role": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "boundingRect": { "$ref": "#/$defs/rect" },
        "ancestors": { "type": "array", "items": { "type": "string" } },
        "outerHtml": { "type": "string" },
        "component": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "description": "Component / source info from a framework adapter. null when none matched.",
              "required": ["name", "stack", "source"],
              "properties": {
                "name": { "type": ["string", "null"] },
                "stack": { "type": "array", "items": { "type": "string" } },
                "source": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["file", "line"],
                      "properties": {
                        "file": { "type": "string" },
                        "line": { "type": "integer" }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
