{
  "name": "@tracepoint-dev/react",
  "version": "0.1.2",
  "description": "React adapter for the Tracepoint feedback & diagnostics SDK.",
  "license": "MIT",
  "author": "Amit Mishra",
  "homepage": "https://github.com/tracepoint-dev/tracepoint/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracepoint-dev/tracepoint.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/tracepoint-dev/tracepoint/issues",
  "keywords": ["feedback", "bug-report", "diagnostics", "react", "sdk"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@tracepoint-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
